<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Avec les femmes{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2280%22>🌿</text></svg>">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <div class="app-shell">
            <header class="topbar">
                <a class="brand" href="{{ path('app_home') }}" aria-label="Accueil Avec les femmes">
                    <span class="brand-mark">AF</span>
                    <span class="brand-name">Avec les femmes</span>
                </a>
                <nav class="main-nav" aria-label="Navigation principale">
                    <a class="nav-link {{ app.request.attributes.get('_route') == 'app_home' ? 'is-active' : '' }}" href="{{ path('app_home') }}">Accueil</a>
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_exercice_' ? 'is-active' : '' }}" href="{{ path('app_exercice_index') }}">Exercices</a>
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_groupement_' ? 'is-active' : '' }}" href="{{ path('app_groupement_index') }}">Groupements</a>
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_membre_' ? 'is-active' : '' }}" href="{{ path('app_membre_index') }}">Membres</a>
                </nav>
            </header>
            <div class="page-content">
                {% block body %}{% endblock %}
            </div>
            <footer class="site-footer">
                <span>Avec les femmes</span>
                <span>Gestion des groupements et des exercices</span>
            </footer>
        </div>
    </body>
</html>
